{
	"name": "skiff-agent",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "A lightweight desktop shell for AI coding agents. Any API key. Every token visible.",
	"license": "MIT",
	"scripts": {
		"dev": "vite",
		"build": "tsc && vite build",
		"test": "node --import ./tests/register.mjs --test tests/*.test.ts",
		"test:styles": "node scripts/check-styles.mjs",
		"check:ui": "tsc --project tests/tsconfig.ui.json",
		"preview": "vite preview",
		"tauri": "tauri",
		"release": "node scripts/release.mjs"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.0.0",
		"@xterm/addon-fit": "^0.11.0",
		"@xterm/xterm": "^6.0.0",
		"highlight.js": "^11.12.0",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-markdown": "^10.1.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1"
	},
	"devDependencies": {
		"@tauri-apps/cli": "^2.0.0",
		"@types/react": "^18.3.0",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react": "^4.3.0",
		"postcss": "^8.5.29",
		"typescript": "^5.7.3",
		"vite": "^7.1.6"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}
